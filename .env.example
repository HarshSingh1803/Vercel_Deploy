# GET-RISE
# Copy this file to `.env.local` for development and set the same
# values in the Vercel project settings for production.
#
# Use the project URL and the anon / publishable key only.
# Never put the service-role key in this file or in frontend code.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional alias used by newer Supabase projects. Either this or ANON_KEY is enough.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used for metadata, sitemap, and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Python video downloader (yt-dlp) used for Instagram/YouTube/Facebook/TikTok links.
VIDEO_DOWNLOADER_URL=http://127.0.0.1:8000

# Optional. Official Meta Login for publishing to your own Instagram professional account.
# Never put the Meta app secret in NEXT_PUBLIC_* variables.
# NEXT_PUBLIC_META_APP_ID=
